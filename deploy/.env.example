# ===== KouHuBot 部署环境变量 =====
# 复制为 .env 后再修改：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库

# 时区
TZ=Asia/Shanghai

# ---- WebUI 绑定地址 ----
# 只监听本机，通过 SSH 隧道访问：
#   ssh -L 6185:127.0.0.1:6185 user@your-server
# 然后浏览器打开 http://127.0.0.1:6185
#
# 如果确认服务器防火墙已限制来源 IP，想直接公网访问，改成 0.0.0.0:6185:6185
WEBUI_BIND=127.0.0.1

# 宿主机端口（容器内固定 6185）。6185 被占用时改这里，
# 记得 SSH 隧道和浏览器地址里的端口一起改。
WEBUI_PORT=6185

# ---- 内存上限（2C2G 关键配置） ----
# AstrBot 主体限 900MB，留出约 1GB 给系统 + 页缓存
# QQ 官方机器人不需要 NapCat，这个额度非常宽裕
ASTRBOT_MEM_LIMIT=900m

# 容器可使用的 swap 上限（防止 OOM Kill，需宿主机已有 swap）
ASTRBOT_MEMSWAP_LIMIT=1800m

# ---- 数据目录 ----
# 宿主机上的持久化目录，挂载到容器内 /AstrBot/data
DATA_DIR=../data

# ---- 镜像版本 ----
# 只在运行依赖改变时升级；插件独立Git更新并挂载。
KOUHUBOT_IMAGE=ia3000/kouhubot
KOUHUBOT_TAG=runtime-1

# 已有容器使用update.sh保留本地环境，不需要重新拉基础镜像。
